# ─────────────────────────────────────────────────────────────────────────────
# RevenueOS — environment configuration
# Copy to .env (or run `pnpm setup`, which generates the secrets for you).
# Values marked [secret] must never be committed, logged or sent to the browser.
# Social/payment/WhatsApp credentials are NOT configured here: connect them in the
# app (Settings → Integrations / each workspace → Connections); they are stored
# encrypted in the database with APP_ENCRYPTION_KEY.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Postgres connection. Local: postgres://postgres:postgres@localhost:5432/revenueos
# Supabase: Project Settings → Database → Connection string (URI).
#   Use the session pooler (port 5432) for the worker; the transaction pooler
#   (port 6543) also works (prepared statements are disabled automatically).
# ↓ [secret]
DATABASE_URL=postgres://postgres:postgres@localhost:5432/revenueos
# Optional pool tuning
# DATABASE_POOL_MAX=10
# ↓ disable prepared statements (any transaction-mode pooler)
# DATABASE_POOLER=true
# DATABASE_APP_NAME=revenueos

# 32 random bytes, base64 or hex. Encrypts every stored credential (AES-256-GCM)
# and derives the signing keys (sessions, OAuth state, tracked links, file URLs).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes existing stored credentials unreadable (re-connect integrations).
# ↓ [secret]
APP_ENCRYPTION_KEY=

# Public URL of the dashboard (used for OAuth redirects, webhooks, tracked links).
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# "Explore Demo" button + demo workspaces (clearly marked DEMO; never publish for real).
DEMO_MODE_ENABLED=true

# Protects /api/cron/tick when an external scheduler (Vercel Cron, Supabase pg_cron,
# GitHub Actions…) calls it. Send as: Authorization: Bearer <CRON_SECRET>
# ↓ [secret]
CRON_SECRET=

# debug | info | warn | error  (secrets are always redacted)
LOG_LEVEL=info

# ── Storage ──────────────────────────────────────────────────────────────────
# local    → files under .data/storage (single computer: dashboard + worker together)
# supabase → Supabase Storage (dashboard on Vercel, worker at home). Required for
#            publishing to Instagram/TikTok/YouTube from the cloud.
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=./.data/storage
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# ↓ [secret] server/worker only
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=revenueos
# REVENUEOS_DATA_DIR=./.data

# ── Claude (optional here — can also be set in Settings → AI, stored encrypted) ─
# ↓ [secret]
# ANTHROPIC_API_KEY=
# Path to the official Claude Code CLI when using "Claude Code (local login)"
# as provider on the worker. Uses only the CLI's documented non-interactive mode.
# CLAUDE_CLI_PATH=claude

# ── Social platform APPS (developer apps you create once; per-business accounts
#    are connected with OAuth inside the app). Can also be set in Settings → Integrations.
# Instagram API with Instagram Login (developers.facebook.com → your app → Instagram)
# INSTAGRAM_APP_ID=
# ↓ [secret]
# INSTAGRAM_APP_SECRET=
# Facebook Pages / Reels (Facebook Login for Business)
# META_APP_ID=
# ↓ [secret]
# META_APP_SECRET=
# META_GRAPH_VERSION=v23.0
# TikTok Content Posting API (developers.tiktok.com)
# TIKTOK_CLIENT_KEY=
# ↓ [secret]
# TIKTOK_CLIENT_SECRET=
# true only after TikTok approves your app audit (unaudited apps can only post privately)
# TIKTOK_APP_AUDITED=false
# YouTube Data API v3 (console.cloud.google.com → OAuth client "Web application")
# GOOGLE_CLIENT_ID=
# ↓ [secret]
# GOOGLE_CLIENT_SECRET=

# ── Local worker (render + AI on your computer) ──────────────────────────────
# Render folder. Default: D:\RevenueOS\renders when a D: drive exists, otherwise
# %USERPROFILE%\RevenueOS\renders (~/RevenueOS/renders on macOS/Linux).
# REVENUEOS_RENDER_DIR=
# WORKER_UI_PORT=4417
# WORKER_RENDER_CONCURRENCY=1
# WORKER_AI_CONCURRENCY=2
# ↓ config/logs folder (default %APPDATA%\RevenueOS)
# REVENUEOS_WORKER_HOME=
# ↓ disable the Windows tray icon
# REVENUEOS_NO_TRAY=1
# Remotion downloads its own headless Chrome on first run; override only if needed.
# REMOTION_BROWSER_EXECUTABLE=
# REMOTION_GL=angle
# FFmpeg ships with Remotion; override only if needed.
# FFMPEG_PATH=
# FFPROBE_PATH=
# Browser for website screenshots (default: Microsoft Edge on Windows, Chrome elsewhere)
# SCREENSHOT_BROWSER_EXECUTABLE=

# ── Development / tests ──────────────────────────────────────────────────────
# ↓ enables `pnpm db:reset` (drops all data!)
# ALLOW_DB_RESET=true
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/revenueos_test
