{
  "name": "@revenueos/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "generate": "drizzle-kit generate",
    "migrate": "tsx scripts/migrate.ts",
    "reset": "tsx scripts/reset.ts",
    "seed": "pnpm --filter @revenueos/core seed"
  },
  "dependencies": {
    "@revenueos/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
